# {{ ansible_managed }}

[Unit]
Description=Run the branding backend
After=network.target
OnFailure=failure-notificator@%n.service

[Service]
Type=simple
User=branding
Group=branding
Restart=always
WorkingDirectory={{ home }}
ExecStart={{ home }}/server
EnvironmentFile={{ home }}/.env

[Install]
WantedBy=multi-user.target
