#!/usr/bin/env python3
# {{ ansible_managed }}

"""
MMM activiteiten-sync: Koala -> listmonk

Haalt de eerstvolgende activiteiten vanaf maandag uit de Koala API (ook als ze
later dan die week vallen, maar max. 3 weken vooruit) en zet de ID's (max. 6, gesorteerd op starttijd) in de attributen van de
MMM-campagne in listmonk. Het template bouwt daar de posters en links mee op.

Gebruik:
    python3 mmm_activiteiten.py                  # nieuwste campagne met tag mmm (concept of ingepland) bijwerken
    python3 mmm_activiteiten.py --dry-run        # alleen tonen wat er zou gebeuren
    python3 mmm_activiteiten.py --print          # alleen de JSON printen (geen listmonk nodig)
    python3 mmm_activiteiten.py --campaign 42    # specifieke campagne bijwerken
    python3 mmm_activiteiten.py --week 2026-10-05
"""
import argparse
import base64
import json
import os
import sys
import urllib.parse
import urllib.request
from datetime import date, datetime, timedelta
from zoneinfo import ZoneInfo

KOALA_URL = "https://api.koala.{{ canonical_hostname }}/activities/"
MAX_ACTIVITEITEN = 6
MAX_WEKEN_VOORUIT = 3
CAMPAGNE_TAG = "mmm"
TZ = ZoneInfo("Europe/Amsterdam")

# ---------- Koala ----------

def week_start(arg=None):
    if arg:
        return date.fromisoformat(arg)
    vandaag = datetime.now(TZ).date()
    # Op maandag zelf: deze week. Anders: de eerstvolgende maandag.
    return vandaag + timedelta(days=(7 - vandaag.weekday()) % 7)

def haal_activiteiten():
    req = urllib.request.Request(KOALA_URL, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)

def selecteer(activiteiten, start):
    # De eerstvolgende activiteiten vanaf maandag, ook als ze na die week vallen,
    # maar niet verder dan MAX_WEKEN_VOORUIT (dus geen 'save the dates' van maanden later).
    eind = start + timedelta(weeks=MAX_WEKEN_VOORUIT)
    gekozen = []
    for a in activiteiten:
        if not a.get("showInKoala", True):
            continue
        begin = datetime.fromisoformat(a["dateTimeStart"]).astimezone(TZ)
        if start <= begin.date() < eind:
            gekozen.append((begin, a["id"]))
    gekozen.sort()
    return [activiteit_id for _, activiteit_id in gekozen[:MAX_ACTIVITEITEN]]

# ---------- listmonk ----------

class Listmonk:
    def __init__(self):
        self.url = "https://listmonk.{{ canonical_hostname }}"
        user = "{{ secret_listmonk.mmm_user }}"
        token = "{{ secret_listmonk.mmm_token }}"
        self.auth = f"token {user}:{token}"

    def call(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(
            self.url + path, data=data, method=method,
            headers={"Authorization": self.auth, "Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.load(resp)["data"]
        except urllib.error.HTTPError as e:
            sys.exit(f"listmonk gaf een fout ({e.code}) op {method} {path}: {e.read().decode()}")

    def nieuwste_concept(self):
        params = urllib.parse.urlencode([
            # Ook 'scheduled': de campagne wordt vooraf ingepland voor maandag 9:00.
            # 'tag' (enkelvoud): listmonk v6.2 negeert 'tags' en geeft dan alles terug.
            ("tag", CAMPAGNE_TAG), ("status", "draft"), ("status", "scheduled"),
            ("order_by", "created_at"), ("order", "DESC"),
            ("per_page", "1"), ("no_body", "true"),
        ])
        results = self.call("GET", f"/api/campaigns?{params}")["results"]
        if not results:
            sys.exit(f"Geen campagne met tag {CAMPAGNE_TAG} gevonden (draft of scheduled)")
        return results[0]["id"]

    def zet_activiteiten(self, campagne_id, ids, dry_run=False):
        camp = self.call("GET", f"/api/campaigns/{campagne_id}")
        attribs = dict(camp.get("attribs") or {})  # andere attributen blijven behouden
        attribs["activities"] = ids
        body = {"lists": [l["id"] for l in camp["lists"]], "attribs": attribs}
        print(f"Campagne {campagne_id}: '{camp['name']}' ({camp['status']})", file=sys.stderr)
        if dry_run:
            print("Dry run, niets aangepast. Zou versturen:", json.dumps(body), file=sys.stderr)
            return
        self.call("PUT", f"/api/campaigns/{campagne_id}", body)
        print("Bijgewerkt.", file=sys.stderr)

def main():
    p = argparse.ArgumentParser(description="Zet de eerstvolgende activiteiten in de MMM-campagne.")
    p.add_argument("--week", help="maandag vanaf wanneer activiteiten meetellen (JJJJ-MM-DD)")
    p.add_argument("--campaign", type=int, help="campagne-ID (standaard: nieuwste MMM-concept)")
    p.add_argument("--dry-run", action="store_true", help="niets aanpassen, alleen tonen")
    p.add_argument("--print", action="store_true", help="alleen de JSON printen")
    args = p.parse_args()

    start = week_start(args.week)
    ids = selecteer(haal_activiteiten(), start)
    print(f"{len(ids)} activiteit(en) vanaf {start:%d-%m-%Y}: {ids}", file=sys.stderr)

    if args.print:
        print(json.dumps({"activities": ids}))
        return

    lm = Listmonk()
    lm.zet_activiteiten(args.campaign or lm.nieuwste_concept(), ids, args.dry_run)

if __name__ == "__main__":
    main()
