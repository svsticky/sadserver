# {{ ansible_managed }}
# Settings for postgres database
DB_USER=mongoose
DB_PASSWORD=
DB_HOST=/run/postgresql
DB_PORT=

# Token
API_TOKEN={{ vault_secret_mongoose.api_key }}

# Settings for django
DJANGO_KEY={{ vault_secret_mongoose.django_key }}
TIMEZONE=Europe/Amsterdam
BASE_URL=https://mongoose.{{ canonical_hostname }}

# Settings for user API
USER_URL=https://keycloak.{{ canonical_hostname }}

# Keycloak admin API (mongoose-backend service account: card registration
# student-number lookups, and per-user profile fetches for name/email/birthday)
KEYCLOAK_URL=https://keycloak.{{ canonical_hostname }}
KEYCLOAK_REALM={{ secret_tavern.keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ vault_secret_mongoose.keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ vault_secret_mongoose.keycloak_client_secret }}

# Mailgun info
MAILGUN_ENV={{ canonical_hostname }}
MAILGUN_TOKEN={{ secret_mailgun_token }}

DEBUG={{ 'True' if 'staging' in group_names else 'False' }}

ALLOWED_HOSTS=mongoose.{{ canonical_hostname }}

OIDC_RP_CLIENT_ID={{ secret_oauth2_proxy.client_id }}
OIDC_RP_CLIENT_SECRET={{ secret_oauth2_proxy.client_secret }}

OIDC_OP_AUTHORIZATION_ENDPOINT=https://keycloak.{{ canonical_hostname }}/realms/{{ secret_tavern.keycloak_realm }}/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://keycloak.{{ canonical_hostname }}/realms/{{ secret_tavern.keycloak_realm }}/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://keycloak.{{ canonical_hostname }}/realms/{{ secret_tavern.keycloak_realm }}/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=https://keycloak.{{ canonical_hostname }}/realms/{{ secret_tavern.keycloak_realm }}/protocol/openid-connect/certs

MOLLIE_API_KEY={{ secret_mollie_token_mongoose }}
