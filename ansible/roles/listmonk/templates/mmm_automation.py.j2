#!/usr/bin/env python3
# {{ ansible_managed }}

"""
This script retrieves the public activities starting coming Monday from
Koala and puts their IDs in the attributes of the latest MMM campaign in
Listmonk (max 6 activities, sorted on time).  The MMM template uses these
IDs to build the links to the activities and their posters.
Furthermore, it grabs data (story, image, dilemma, etc.) from a spreadsheet to fill in the rest of the MMM. 

Usage:
    python3 mmm_automation.py
    Update latest compaign with the mmm tag (either concept or planned)

    python3 mmm_automation.py --dry-run
    Show the updates to Listmonk without sending requests to Listmonk

    python3 mmm_automation.py --print
    Print the JSON that can be pasted into the Listmonk campaign (doesn't require Listmonk to run)

    python3 mmm_automation.py --campaign 42
    python3 mmm_automation.py --week 2026-10-05
    Update specific campaign
"""
import argparse
import base64
import json
import os
import sys
import urllib.parse
import urllib.request
import requests
from datetime import date, datetime, timedelta
from zoneinfo import ZoneInfo
import gspread
from google.oauth2.service_account import Credentials
import html
import gdown
from time import strftime
from PIL import Image
import io
import re
from googleapiclient.discovery import build
from googleapiclient.http import MediaIoBaseDownload

KOALA_URL = "https://api.koala.{{ canonical_hostname }}/activities/"
MAX_ACTIVITIES = 6
MAX_WEEKS_AHEAD = 3
CAMPAIGN_TAG = "mmm"
TZ = ZoneInfo("Europe/Amsterdam")

# ---------- Google Drive/Sheets ----------

google_scopes = [
    "https://www.googleapis.com/auth/spreadsheets",
    "https://www.googleapis.com/auth/drive.readonly",
]
google_creds = Credentials.from_service_account_file("credentials.json", scopes=google_scopes)
client = gspread.authorize(google_creds)
drive = build("drive", "v3", credentials=google_creds)

def extract_drive_id(url):
    m = re.search(r"/d/([A-Za-z0-9_-]+)", url) or re.search(r"[?&]id=([A-Za-z0-9_-]+)", url)
    if not m:
        sys.exit(f"Cannot find Drive file ID in: {url}")
    return m.group(1)

def download_banner(url):
    file_id = extract_drive_id(url)

    # Check metadata
    meta = drive.files().get(fileId=file_id, fields="mimeType").execute()
    if not meta["mimeType"].startswith("image/"):
        sys.exit(f"No image, but {meta['mimeType']}")

    # Download to memory
    buf = io.BytesIO()
    downloader = MediaIoBaseDownload(buf, drive.files().get_media(fileId=file_id))
    done = False
    while not done:
        _, done = downloader.next_chunk()
    buf.seek(0)

    # Validate and convert to PNG
    with Image.open(buf) as img:
        img.verify()
    buf.seek(0)
    with Image.open(buf) as img:
        if img.format not in {"JPEG", "JPG", "PNG", "WEBP"}:
            raise ValueError(f"Unsupported format: {img.format}")
        out = io.BytesIO()
        img.convert("RGBA").save(out, "PNG")

    timestamp = strftime("%Y%m%d%H%M%S")
    filename = f"mmm_banner_{timestamp}.png"
    return filename, out.getvalue()

# Open MMM Google Sheet
sheet_id = "{{ secret_listmonk.google_sheet_id }}"
workbook = client.open_by_key(sheet_id)

def get_row_data():
    MAX_ROW_AMOUNT = 100
    previous_row_data = workbook.sheet1.row_values(1)
    for row_idx in range(2, MAX_ROW_AMOUNT):
        next_row_data = workbook.sheet1.row_values(row_idx)
        if not next_row_data:
            return previous_row_data
        else:
            previous_row_data = next_row_data

# ---------- Koala ----------

def week_start(arg=None):
    if arg:
        return date.fromisoformat(arg)
    today = datetime.now(TZ).date()
    return today + timedelta(days=(7 - today.weekday()) % 7)

def retrieve_activities():
    req = urllib.request.Request(KOALA_URL, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)

def select(activities, start):
    # The upcoming activities starting Monday, even if they are planned in later weeks,
    # but no later than MAX_WEEKS_AHEAD (to prevent 'save the dates' activities from showing up). 
    end = start + timedelta(weeks=MAX_WEEKS_AHEAD)
    chosen = []
    for a in activities:
        if len(chosen) >= MAX_ACTIVITIES:
            break
        if not a.get("showInKoala", True):
            continue
        activity_start = datetime.fromisoformat(a["dateTimeStart"]).astimezone(TZ)
        if start <= activity_start.date() < end:
            chosen.append((activity_start, a["id"]))
    chosen.sort()
    return [activity_id for _, activity_id in chosen]

def retrieve_poster(activity_id):
    """Returns (content, content_type) or None if the activity has no poster."""
    req = urllib.request.Request(KOALA_URL + str(activity_id) + "/poster")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            content_type = resp.headers.get_content_type()
            return resp.read(), content_type
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        sys.exit(f"Koala error ({e.code}) while fetching poster {activity_id}")

# ---------- listmonk ----------

class Listmonk:
    def __init__(self):
        self.url = "https://listmonk.{{ canonical_hostname }}"
        user = "{{ secret_listmonk.mmm_user }}"
        token = "{{ secret_listmonk.mmm_token }}"
        self.auth = f"token {user}:{token}"

    def call(self, method, path, body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(
            self.url + path, data=data, method=method,
            headers={"Authorization": self.auth, "Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.load(resp)["data"]
        except urllib.error.HTTPError as e:
            sys.exit(f"Listmonk error ({e.code}): {method} {path}: {e.read().decode()}")

    def latest_concept(self):
        params = urllib.parse.urlencode([
            ("tag", CAMPAIGN_TAG), ("status", "draft"), ("status", "scheduled"),
            ("order_by", "created_at"), ("order", "DESC"),
            ("per_page", "1"), ("no_body", "true"),
        ])
        results = self.call("GET", f"/api/campaigns?{params}")["results"]
        if not results:
            sys.exit(f"No campaign found with tag {CAMPAIGN_TAG}")
        return results[0]["id"]

    def upload_image(self, filename, content, content_type):
        resp = requests.post(
            self.url + "/api/media",
            headers={"Authorization": self.auth},  # no Content-Type: requests sets the multipart boundary
            files={"file": (filename, content, content_type)},
            timeout=30,
        )
        if not resp.ok:
            sys.exit(f"Listmonk error ({resp.status_code}): POST /api/media: {resp.text}")
        return resp.json()["data"]["url"]

    def get_body(self, camp, activity_ids, dry_run):
        body = {}
        body["lists"] = [l["id"] for l in camp["lists"]]
        
        row_data = get_row_data()
        subject = row_data[2]
        author = row_data[3]

        # Banner
        filename, content = download_banner(row_data[4])
        banner_listmonk_link = self.upload_image(filename, content, "image/png")

        # Story
        text = row_data[5].replace("\r\n", "\n")
        paragraphs = html.escape(text).split("\n\n")
        story = "".join(f"<p>{p.replace(chr(10), '<br>')}</p>" for p in paragraphs)

        dilemma_1 = row_data[6]
        dilemma_2 = row_data[7]

        body["subject"] = subject

        attribs = dict(camp.get("attribs") or {}) # other attributes will remain
        attribs["Author"] = author
        attribs["Banner"] = banner_listmonk_link
        attribs["Story"] = story
        attribs["Dilemma_1"] = dilemma_1
        attribs["Dilemma_2"] = dilemma_2
        attribs["activities"] = activity_ids

        # Activities
        for activity_id in activity_ids:
            poster = retrieve_poster(activity_id)
            if dry_run:
                print(f"Dry run, would upload poster for {activity_id}")
            else:
                filename = f"poster-{activity_id}.webp"
                self.upload_image(filename, *poster)

        body["attribs"] = attribs
        return body

    def update_email_content(self, campaign_id, activity_ids, dry_run=False):
        camp = self.call("GET", f"/api/campaigns/{campaign_id}")
        
        body = self.get_body(camp, activity_ids, dry_run)
        
        print(f"Campaign {campaign_id}: '{camp['name']}' ({camp['status']})", file=sys.stderr)
        if dry_run:
            print("Dry run, nothing updated. Would send:", json.dumps(body), file=sys.stderr)
            return
        self.call("PUT", f"/api/campaigns/{campaign_id}", body)
        print("Updated.", file=sys.stderr)

def main():
    p = argparse.ArgumentParser(description="Update the latest MMM campaign with next weeks' activities & spreadsheet data")
    p.add_argument("--week", help="Monday from when activities should be included (YYYY-MM-DD)")
    p.add_argument("--campaign", type=int, help="Campaign ID, default: the latest campaign")
    p.add_argument("--dry-run", action="store_true", help="Do not send the update request to Listmonk")
    p.add_argument("--print", action="store_true", help="Just print the attributes JSON")
    args = p.parse_args()

    start = week_start(args.week)
    ids = select(retrieve_activities(), start)
    print(f"{len(ids)} activiteit(en) vanaf {start:%d-%m-%Y}: {ids}", file=sys.stderr)

    if args.print:
        print(json.dumps({"activities": ids}))
        return

    lm = Listmonk()
    lm.update_email_content(args.campaign or lm.latest_concept(), ids, args.dry_run)

if __name__ == "__main__":
    main()
