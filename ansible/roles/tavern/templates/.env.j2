# ==============================================================================
# TAVERN CORE CONFIGURATION (Ports & Hosts)
# ==============================================================================
FrontendPort={{ tavern_frontend_port }}
BackendPort={{ tavern_backend_port }}
DocsPort={{ tavern_docs_port }}
HostUrl=https://koala.{{ canonical_hostname }}
ApiUrl=https://api.koala.{{ canonical_hostname }}

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
PostgresqlConnectionString=Host=/run/postgresql/;Username=tavern;Password={{ secret_tavern.postgres_password }};Database=tavern

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# Auth System (Keycloak)
AUTH_SYSTEM=KEYCLOAK
KeycloakUrl={{ secret_tavern.keycloak_url }}
KeycloakRealm={{ secret_tavern.keycloak_realm }}
KeycloakClientId={{ secret_tavern.keycloak_client_id }}
KeycloakBackendClientId={{ secret_tavern.keycloak_backend_client_id }}
KeycloakClientSecret={{ secret_tavern.keycloak_client_secret }}
keycloak_webhook_secret={{ secret_tavern.keycloak_webhook_secret }}

# ==============================================================================
# ACCOUNTING FEATURE TOGGLE
# ==============================================================================
ACCOUNTING_ENABLED=false

# ==============================================================================
# THEME & UI CUSTOMIZATION (Vite)
# ==============================================================================
LOGO_URL={{ secret_tavern.logo_url | default('') }}

# ==============================================================================
# INFRASTRUCTURE & STORAGE (S3)
# ==============================================================================
S3_ACCESS_KEY_ID={{ secret_tavern.aws_access_key_id }}
S3_SECRET_ACCESS_KEY={{ secret_tavern.aws_secret_access_key }}
S3_REGION={{ secret_tavern.aws_region | default('us-east-1') }}
S3_SERVICE_URL={{ secret_tavern.s3_service_url }}

# ==============================================================================
# BACKUP ACCOUNT EMAIL (Optional)
# ==============================================================================
BACKUP_ACCOUNT_EMAIL={{ secret_tavern.backup_account_email }}