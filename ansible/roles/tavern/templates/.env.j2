PostgresConnectionString=Host=/run/postgresql/;Username=tavern;Password={{ secret_tavern.postgres_password }};Database=tavern

KeycloakUrl={{ secret_tavern.keycloak_url }}
KeycloakRealm={{ secret_tavern.auth_realm }}
KeycloakClientId={{ secret_tavern.keycloak_client_id }}
KeycloakBackendClientId={{ secret_tavern.keycloak_backend_client_id }}
KeycloakClientSecret={{ secret_tavern.keycloak_client_secret }}
auth_WEBHOOK_SECRET={{ secret_tavern.auth_webhook_secret }}

MollieApiKey={{ secret_tavern.mollie_api_key }}
BACKUP_ACCOUNT_EMAIL={{ secret_tavern.backup_account_email }}

LOGO_URL={{ secret_tavern.logo_url | default('') }}
BOARD_PRIMARY_LIGHT={{ secret_tavern.board_primary_light | default('#f98f55ff') }}
BOARD_PRIMARY={{ secret_tavern.board_primary | default('#fa6b20') }}
BOARD_PRIMARY_DARK={{ secret_tavern.board_primary_dark | default('#ca5617') }}

AWS_ACCESS_KEY_ID={{ secret_tavern.aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ secret_tavern.aws_secret_access_key }}
