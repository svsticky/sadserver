# {{ ansible_managed }}

[Unit]
Description=Fetch next weeks' activities from Koala's public API, and place them in the latest campaign in Listmonk. Fetch the current data from the spreadsheet to fill out the rest of the MMM.

[Timer]
OnCalendar=Fri *-*-* 16:30:00 Europe/Amsterdam
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
