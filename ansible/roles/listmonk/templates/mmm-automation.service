# {{ ansible_managed }}

[Unit]
Description=Fetch next weeks' activities from Koala's public API, and place them in the latest campaign in Listmonk. Fetch the current data from the spreadsheet to fill out the rest of the MMM.
OnFailure=failure-notificator@%n.service

[Service]
Type=oneshot
User=root
Group=root
PrivateTmp=true
EnvironmentFile=/var/www/listmonk/mmm-bot/.env
ExecStart=uv run mmm-bot
WorkingDirectory=/var/www/listmonk/mmm-bot
