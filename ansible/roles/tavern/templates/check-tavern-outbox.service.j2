# {{ ansible_managed }}

[Unit]
Description=Check whether one of Tavern's outbox queues is stuck
After=postgresql.service
OnFailure=failure-notificator@%n.service

[Service]
Type=oneshot
User=tavern
Group=tavern
StateDirectory=tavern-outbox-monitor
Environment=PGPASSFILE={{ tavern_home_dir }}/.pgpass
ExecStart=/usr/local/bin/check-tavern-outbox.sh
